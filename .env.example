# Copy this file to .env, then fill ONE LLM provider if you want real answers.
# Keep .env private; it is ignored by git.

# LLM_PROVIDER=mock | gemini | openrouter
LLM_PROVIDER=mock
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=600

# Gemini API: https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_LLM_MODEL=gemini-3.6-flash

# OpenRouter API: https://openrouter.ai/keys
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=K4-L3B PolicyLens

# Retrieval embedding provider: mock | local | gemini | openai
# Keep mock unless you have installed/configured a real embedding backend.
EMBEDDING_PROVIDER=mock
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
